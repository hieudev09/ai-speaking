# === DATABASE ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_speaking_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_speaking_db?schema=public"

# === REDIS ===
REDIS_URL="redis://localhost:6379"

# === JWT ===
JWT_SECRET="change-me-super-secret-jwt-key-min-32-characters-here"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-refresh-token-secret-min-32-characters-here"
REFRESH_TOKEN_EXPIRES_IN="30d"

# === AI PROVIDERS ===
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_AI_API_KEY="AIza..."

# === FILE STORAGE — choose one ===
# Option A: AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""
# Option B: Cloudflare R2
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# === EMAIL ===
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@ai-speaking.com"
